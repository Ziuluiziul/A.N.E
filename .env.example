# A.N.E. — variáveis do sistema. Apenas nomes e explicações, nunca valores.
#
# Os valores reais moram fora do repositório, em:
#
#     ~/.config/vault-autodidata/secrets.env      (permissão 600)
#
# O backend lê esse arquivo diretamente; copiar este exemplo para .env não é o
# caminho previsto e o .env está no .gitignore justamente por isso.

# --- Modelos ---------------------------------------------------------------

# Chave da API Gemini, obtida no Google AI Studio (aistudio.google.com/apikey).
# Free tier. Usada pelo SDK google-genai.
GEMINI_API_KEY=

# Chave da Groq Cloud (console.groq.com/keys). Conta gratuita.
GROQ_API_KEY=

# Chave do NVIDIA Build / NIM (build.nvidia.com). Free tier, consumida por um
# cliente compatível com a API da OpenAI apontado para integrate.api.nvidia.com.
NVIDIA_API_KEY=

# Chave do Ollama Cloud (ollama.com/settings/keys). Vai no header Authorization
# Bearer para https://ollama.com/api, que é a própria API da Ollama servida como host
# remoto. Sem ela o adaptador não é construído; a instalação local em localhost:11434
# fala o mesmo protocolo sem credencial, e não é o que esta variável configura.
OLLAMA_API_KEY=

# Chave do OpenRouter (openrouter.ai/settings/keys). O adaptador aceita somente
# variantes estáticas publicadas cujo ID termina em :free; ele nunca omite o modelo,
# nunca sintetiza o sufixo e nunca usa o roteador aleatório openrouter/free. Use uma
# chave dedicada com spending limit USD 0 e "Include BYOK usage in limit" ativo:
# chaves sem essas duas guardas são recusadas.
# Antes de ativar, confirme também que o plugin Web não está travado com Firecrawl;
# `/key` não expõe essa configuração externa nem consegue proteger seus créditos.
OPENROUTER_API_KEY=

# Opt-in de risco, desligado por padrão. Use `1` somente quando `/key` identificar a
# conta exatamente como free-tier, sem teto configurado e com BYOK fora do limite.
# As rotas continuam restritas a :free e preço zero, mas uma chave BYOK vinculada à
# conta pode consumir créditos do provedor externo porque não há teto que a proteja.
OPENROUTER_ALLOW_UNCAPPED_FREE_TIER=

# Chave da API de inferência da Nous Research (portal.nousresearch.com → API keys).
# Base: https://inference-api.nousresearch.com/v1 (OpenAI-compatível). Documentação:
# portal.nousresearch.com/api-docs. O adaptador aceita somente variantes `:free`
# publicadas com preço zero — nunca um modelo pago, mesmo por preferência manual.
# O free tier declara 50 RPM e 500.000 TPM. `/v1/models` é público: a verificação
# da chave usa uma chamada mínima de 1 token, não a listagem.
NOUS_API_KEY=

# --- Google Workspace ------------------------------------------------------
# Integração distinta da API Gemini: exige projeto no Google Cloud, APIs
# habilitadas e consentimento OAuth do usuário. Ver docs/GOOGLE-WORKSPACE.md.

# Caminho do client_secret baixado do Google Cloud Console (tipo "Desktop app").
# Fora do repositório. Sugestão: ~/.config/vault-autodidata/credentials.json
GOOGLE_WORKSPACE_CLIENT_SECRET_FILE=

# Caminho onde o token OAuth do usuário é gravado depois do consentimento.
# Fora do repositório. Sugestão: ~/.config/vault-autodidata/token.json
GOOGLE_WORKSPACE_TOKEN_FILE=

# --- Supervisão do Atlas ---------------------------------------------------
# tools/atlas.sh lê estas variáveis; todas têm padrão conservador.

# URL que o supervisor espera e abre no navegador (padrão http://127.0.0.1:5173).
VAULT_ATLAS_URL=

# Segundos de espera máxima até o Atlas responder antes de desistir (padrão 90).
VAULT_ATLAS_TIMEOUT=

# `0` impede a abertura automática do navegador (padrão `1`: abre).
VAULT_ATLAS_OPEN=

# Carência em segundos para encerramento limpo dos serviços (padrão 35).
VAULT_ATLAS_SHUTDOWN_TIMEOUT=

# Intervalo em segundos entre ciclos do worker contínuo (padrão 2).
VAULT_WORKER_INTERVAL=

# --- Demonstração ----------------------------------------------------------

# Camada operacional sintética no Atlas: agente, atividade, evidência, proposta,
# commit e rejeição. Existe para verificar a gramática visual dessa camada antes de
# haver eventos reais. Vazia é o estado normal; `1` só por pedido explícito, e a
# projeção declara `operationalSource: demo` quando ligada.
VAULT_DEMO_OPERATIONAL=

# Worker contínuo junto do Atlas. `1` é o ciclo vivo normal; `0` sobe somente a
# visualização e a API. O worker nunca ultrapassa VAULT_WORK_MAX_CALLS no processo.
VAULT_AUTONOMOUS_WORKER=

# Teto absoluto de chamadas externas em uma execução de work, quorum ou worker.
# Vazio usa o padrão conservador 6; aumentar é uma decisão explícita de consumo.
VAULT_WORK_MAX_CALLS=

# Tarefas de quórum simultâneas por processo do worker. Padrão 3; cada tarefa
# consome ~4 chamadas. O teto efetivo é min(concurrency, max_calls // 4).
VAULT_WORKER_CONCURRENCY=

# Máximo de chamadas simultâneas por provedor neste processo, como objeto JSON.
# Zero pausa o provedor sem remover a chave. Só declare números sustentados pela
# conta atual; endpoints diferentes podem compartilhar o mesmo teto agregado.
# Exemplo: {"google":2,"groq":6,"nvidia":6,"ollama":2,"nous":3,"openrouter":1}
VAULT_PROVIDER_CONCURRENCY=

# --- Caminhos opcionais ----------------------------------------------------
# Só preencha para apontar o sistema a outro corpus ou a outra área de trabalho.
# Vazio significa knowledge/ e runtime/ dentro do repositório.
VAULT_CORPUS_DIR=
VAULT_RUNTIME_DIR=
